{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/img/*",
      "/css/*",
      "/js/*",
      "/data/*",
      "*.{json,webmanifest,svg,png,ico}"
    ]
  },
  "routes": [
    {
      "route": "/data/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}